# Required for the live Phase 1 model call. Never commit a real key.
ANTHROPIC_API_KEY=

# Development uses Anthropic's low-cost model. Override only when deliberately
# comparing model behavior.
ANTHROPIC_MODEL=claude-haiku-4-5

# The integration test remains offline unless this is explicitly set to 1.
RUN_LIVE_ANTHROPIC_TEST=0

# Production runner provider. OpenRouter remains available but Anthropic can
# be used directly when the free router allowance is unavailable.
AGENT_MODEL_PROVIDER=anthropic
RUN_LIVE_AGENT_RUNTIME_TEST=0

# Required for the final model-routing boundary and its explicit live test.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
OPENROUTER_DATA_COLLECTION=deny
RUN_LIVE_OPENROUTER_TEST=0

# Required only for explicit E2B template builds and live sandbox tests.
# The key remains in the host process and is never copied into a sandbox.
E2B_API_KEY=
E2B_TEMPLATE_ID=
E2B_TEMPLATE_NAME=terminal-coding-agent-tools:completion-evidence-v1
RUN_LIVE_E2B_TEST=0

# Optional Step 9 trace export. All four values are required; otherwise
# telemetry stays disabled. Use the base URL of the self-hosted Langfuse
# deployment, without the OTLP path. Never commit real project keys.
AGENT_TELEMETRY_ENABLED=0
LANGFUSE_BASE_URL=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
