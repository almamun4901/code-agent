# Required for the live Phase 1 model call. Never commit a real key.
ANTHROPIC_API_KEY=

# Development uses Anthropic's low-cost model. Override only when deliberately
# comparing model behavior.
ANTHROPIC_MODEL=claude-haiku-4-5

# The integration test remains offline unless this is explicitly set to 1.
RUN_LIVE_ANTHROPIC_TEST=0

# Required for the final model-routing boundary and its explicit live test.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
RUN_LIVE_OPENROUTER_TEST=0

# Required only for explicit E2B template builds and live sandbox tests.
# The key remains in the host process and is never copied into a sandbox.
E2B_API_KEY=
E2B_TEMPLATE_ID=
E2B_TEMPLATE_NAME=terminal-coding-agent-tools:mutation-recovery-v1
RUN_LIVE_E2B_TEST=0
