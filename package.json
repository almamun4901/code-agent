{
  "name": "terminal-native-coding-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "agent": "./bin/agent.ts"
  },
  "scripts": {
    "phase1": "bun run src/loop.ts",
    "mcp:stdio": "bun run src/mcp/stdio-server.ts",
    "test": "bun test tests/loop.test.ts tests/openrouter.test.ts tests/agent-runtime.test.ts tests/runtime-events.test.ts tests/tui.test.tsx tests/cli.test.ts tests/tui-pty.test.ts tests/tools.test.ts tests/safety.test.ts tests/checkpoint.test.ts tests/mcp.test.ts tests/mutation-recovery.test.ts tests/e2b-stdio-transport.test.ts tests/e2b-template.test.ts tests/e2b-session.test.ts tests/e2b-sandbox-admin.test.ts tests/manual-preflight.test.ts",
    "test:tui": "bun test tests/tui.test.tsx",
    "test:cli": "bun test tests/cli.test.ts",
    "test:tui:pty": "bun test tests/tui-pty.test.ts",
    "test:runtime": "bun test tests/agent-runtime.test.ts",
    "test:mcp": "bun test tests/mcp.test.ts",
    "test:sandbox": "bun test tests/e2b-stdio-transport.test.ts tests/e2b-template.test.ts tests/e2b-session.test.ts tests/e2b-sandbox-admin.test.ts",
    "test:safety": "bun test tests/safety.test.ts",
    "test:e2b:integration": "RUN_LIVE_E2B_TEST=1 bun test tests/e2b-transport.integration.test.ts tests/e2b-sandbox.integration.test.ts",
    "test:e2b:transport": "RUN_LIVE_E2B_TEST=1 bun test tests/e2b-transport.integration.test.ts",
    "test:e2b:isolation": "RUN_LIVE_E2B_TEST=1 bun test tests/e2b-sandbox.integration.test.ts",
    "test:e2b:safety": "RUN_LIVE_E2B_TEST=1 bun test tests/e2b-sandbox.integration.test.ts",
    "test:manual:preflight": "bun run src/dev/manual-preflight.ts",
    "test:manual:local": "bun run test:manual:preflight && bun run typecheck && bun test && bun run test:sandbox && bun run loop-fake.ts && git diff --check",
    "e2b:template:check": "bun run src/sandbox/template.ts --dry-run",
    "e2b:template:build": "bun run src/sandbox/template.ts",
    "e2b:sandboxes:list": "bun run src/sandbox/sandbox-admin.ts list",
    "e2b:sandbox:kill": "bun run src/sandbox/sandbox-admin.ts kill",
    "test:integration": "RUN_LIVE_ANTHROPIC_TEST=1 bun test tests/anthropic.integration.test.ts",
    "test:openrouter:integration": "RUN_LIVE_OPENROUTER_TEST=1 bun test tests/openrouter.integration.test.ts",
    "test:runtime:integration": "RUN_LIVE_AGENT_RUNTIME_TEST=1 bun test tests/agent-runtime.integration.test.ts",
    "test:all": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "diff": "^9.0.0",
    "e2b": "2.14.1",
    "gpt-tokenizer": "3.4.0",
    "ink": "7.1.1",
    "react": "19.2.8",
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "0.20.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "19.2.14",
    "ink-testing-library": "4.0.0",
    "typescript": "^5.9.3"
  }
}
